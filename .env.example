# ============================================================================
# Polybot Configuration
# ============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# Spring Boot Configuration
# ----------------------------------------------------------------------------
# Profile: develop, production, etc.
SPRING_PROFILES_ACTIVE=develop

# Trading Mode: PAPER (simulated) or LIVE (real money)
# WARNING: LIVE mode REQUIRES valid Polymarket credentials and will execute real trades!
HFT_MODE=PAPER

# ----------------------------------------------------------------------------
# Polymarket Authentication (Required for live trading)
# ----------------------------------------------------------------------------
# Your Polymarket wallet private key (must include 0x prefix)
HFT_POLYMARKET_AUTH_PRIVATE_KEY=

# Signature type (0 = EOA, 1 = Poly Proxy, 2 = Gnosis Safe)
HFT_POLYMARKET_AUTH_SIGNATURE_TYPE=0

# Funder address (optional, for proxy wallets)
HFT_POLYMARKET_AUTH_FUNDER_ADDRESS=

# API credentials (generated from Polymarket)
HFT_POLYMARKET_AUTH_API_KEY=
HFT_POLYMARKET_AUTH_API_SECRET=
HFT_POLYMARKET_AUTH_API_PASSPHRASE=
HFT_POLYMARKET_AUTH_NONCE=0

# ----------------------------------------------------------------------------
# Strategy Research - Target User (for reverse engineering)
# ----------------------------------------------------------------------------
# The Polymarket username to analyze and replicate
POLYMARKET_TARGET_USER=

# ----------------------------------------------------------------------------
# Analytics Database (ClickHouse)
# ----------------------------------------------------------------------------
# For analytics-service Spring Boot datasource
ANALYTICS_DB_URL=jdbc:clickhouse://localhost:8123/polybot
ANALYTICS_DB_DRIVER=com.clickhouse.jdbc.ClickHouseDriver
ANALYTICS_DB_USERNAME=default
ANALYTICS_DB_PASSWORD=

# For Python research scripts and other tools
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=polybot
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ----------------------------------------------------------------------------
# Monitoring (Optional)
# ----------------------------------------------------------------------------
# Slack webhook for alerts
SLACK_WEBHOOK_URL=

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# ----------------------------------------------------------------------------
# Blockchain RPC
# ----------------------------------------------------------------------------
POLYGON_RPC_URL=https://polygon-rpc.com

# ----------------------------------------------------------------------------
# Kafka (for event streaming)
# ----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
